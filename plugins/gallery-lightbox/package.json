{
  "name": "gallery-lightbox",
  "version": "1.0.0",
  "description": "Visualizador (lightbox) para a página Galeria",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./dist/index.js",
    "./components": "./dist/components/index.js",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
